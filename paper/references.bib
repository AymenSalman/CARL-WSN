	keywords = {{LEACH} protocol, Machine Learning, Magnetic heads, Protocols, Q-learning, Reinforcement learning, Routing, Smart cities, Throughput, Time factors, Traffic congestion, Wireless networks, Wireless sensor networks, {WSN}},
